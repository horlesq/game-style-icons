    "./splatoon": {
      "types": "./src/splatoon.d.ts",
      "import": "./src/splatoon.js",
      "default": "./src/splatoon.js"
    },
    "./animal-crossing": {
      "types": "./src/animal-crossing.d.ts",
      "import": "./src/animal-crossing.js",
      "default": "./src/animal-crossing.js"
    },
    "./hotline-miami": {
      "types": "./src/hotline-miami.d.ts",
      "import": "./src/hotline-miami.js",
      "default": "./src/hotline-miami.js"
    },
    "./mirrors-edge": {
      "types": "./src/mirrors-edge.d.ts",
      "import": "./src/mirrors-edge.js",
      "default": "./src/mirrors-edge.js"
