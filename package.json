    },
    "./svg/*": "./svg/*",
    "./icons.json": "./icons.json"
  },
  "files": [
    "src",
    "svg",
    "icons.json"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "keywords": [
    "icons",
    "react",
    "svg",
    "react-icons",
    "game",
    "gaming",
    "pixel",
    "neon",
